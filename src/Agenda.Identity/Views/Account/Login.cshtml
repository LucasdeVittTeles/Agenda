@model Agenda.Identity.Models.LoginInputModel

<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Entrar | Agenda</title>
    <link rel="stylesheet" href="~/css/login.css" asp-append-version="true" />
</head>
<body>
    <main class="login-container">

        <section class="brand-panel">
            <div class="brand-content">
                <div class="brand-logo">
                    <span class="brand-icon">▦</span>
                    <span>agenda.</span>
                </div>

                <h1>Seu tempo,<br />melhor organizado.</h1>

                <p>
                    Gerencie seus serviços, clientes e
                    agendamentos em um só lugar.
                </p>

                <ul class="benefits">
                    <li>✓ Mais produtividade</li>
                    <li>✓ Agenda organizada</li>
                    <li>✓ Clientes mais satisfeitos</li>
                </ul>
            </div>
        </section>

        <section class="form-panel">
            <div class="form-content">
                <h2>Bem-vindo de volta</h2>
                <p class="subtitle">
                    Entre na sua conta para continuar.
                </p>

                <form asp-controller="Account"
                      asp-action="Login"
                      method="post">

                    @Html.AntiForgeryToken()

                    <input type="hidden" asp-for="ReturnUrl" />

                    <div asp-validation-summary="ModelOnly"
                         class="validation-summary"></div>

                    <div class="form-group">
                        <label asp-for="Email">E-mail</label>
                        <input asp-for="Email"
                               type="email"
                               placeholder="seu@email.com"
                               autocomplete="username" />
                        <span asp-validation-for="Email"
                              class="field-error"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Password">Senha</label>
                        <input asp-for="Password"
                               type="password"
                               placeholder="Digite sua senha"
                               autocomplete="current-password" />
                        <span asp-validation-for="Password"
                              class="field-error"></span>
                    </div>

                    <button type="submit" class="login-button">
                        Entrar
                    </button>
                </form>

                <p class="register-text">
                    Não tem uma conta?
                    <span>Cadastro em breve</span>
                </p>
            </div>
        </section>

    </main>
</body>
</html>
